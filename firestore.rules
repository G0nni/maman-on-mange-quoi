rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function household(hid) {
      return get(/databases/$(database)/documents/households/$(hid)).data;
    }

    function isMember(hid) {
      return signedIn() && request.auth.uid in household(hid).memberUids;
    }

    // Le membre {memberId} est-il bien la personne connectée ?
    function isMe(hid, memberId) {
      return get(/databases/$(database)/documents/households/$(hid)/members/$(memberId)).data.uid == request.auth.uid;
    }

    // ---------- Codes d'invitation ----------
    // Lecture doc par doc uniquement : impossible de lister tous les codes.
    match /joinCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      // Création seulement (pas d'écrasement), et uniquement pour un foyer dont on est
      // membre à l'issue du batch (getAfter voit l'état après écriture).
      allow create: if signedIn()
        && request.auth.uid in getAfter(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.memberUids;
      allow update, delete: if false;
    }

    // ---------- Foyers ----------
    match /households/{hid} {
      // list : requis par la requête where('memberUids', 'array-contains', uid)
      allow get, list: if signedIn() && request.auth.uid in resource.data.memberUids;

      allow create: if signedIn()
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.keys().hasOnly(['name', 'joinCode', 'memberUids', 'createdAt']);

      // Un membre peut uniquement renommer le foyer (ni memberUids, ni joinCode, ni createdAt).
      // Un non-membre (qui a eu l'id via un code) peut uniquement s'ajouter lui-même.
      allow update: if (isMember(hid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60)
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.memberUids.removeAll(resource.data.memberUids).hasOnly([request.auth.uid]));

      allow delete: if false;

      // ---------- Membres ----------
      match /members/{memberId} {
        allow read: if isMember(hid);
        // On ne crée que soi-même. getAfter pour le batch de création du foyer.
        allow create: if signedIn()
          && request.auth.uid in getAfter(/databases/$(database)/documents/households/$(hid)).data.memberUids
          && request.resource.data.uid == request.auth.uid;
        // Rattacher sa session à un membre ("c'est moi"), ou modifier son propre profil.
        allow update: if isMember(hid) && request.resource.data.uid == request.auth.uid;
        allow delete: if false;
      }

      // ---------- Stock ----------
      // L'id est le nom normalisé côté client (stockId) : minuscules, chiffres, tirets.
      // name, addedBy et createdAt sont figés à la création : un setDoc sur un aliment
      // déjà présent est refusé au lieu d'écraser l'existant.
      match /stock/{itemId} {
        function validZone(data) {
          return data.zone in ['frigo', 'placard', 'congel'];
        }
        function validEmoji(data) {
          return data.emoji is string && data.emoji.size() > 0 && data.emoji.size() <= 16;
        }

        allow read, delete: if isMember(hid);

        allow create: if isMember(hid)
          && itemId.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
          && itemId.size() <= 100
          && request.resource.data.keys().hasOnly(['name', 'zone', 'emoji', 'addedBy', 'createdAt'])
          && request.resource.data.keys().hasAll(['name', 'zone', 'emoji', 'addedBy', 'createdAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && validZone(request.resource.data)
          && validEmoji(request.resource.data)
          && request.resource.data.addedBy is string
          && isMe(hid, request.resource.data.addedBy)
          && request.resource.data.createdAt == request.time;

        // Changer de zone (ou d'emoji) plus tard, rien d'autre.
        allow update: if isMember(hid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['zone', 'emoji'])
          && validZone(request.resource.data)
          && validEmoji(request.resource.data);
      }

      // ---------- Préférences du foyer ----------
      // prefs/recipes : { hidden: recipeId[] } (« On n'aime pas »). Pas dans le doc foyer,
      // dont la règle update n'autorise que name.
      match /prefs/{prefId} {
        allow read: if isMember(hid);
        allow create, update: if isMember(hid)
          && prefId == 'recipes'
          && request.resource.data.keys().hasOnly(['hidden'])
          && request.resource.data.hidden is list
          && request.resource.data.hidden.size() <= 500;
        allow delete: if false;
      }

      // ---------- Votes du soir ----------
      // polls/{date} : un vote par jour, date YYYY-MM-DD en heure de Paris.
      // { status: open|closed, options: recipeId[] (1 à 4), createdBy: memberId, winner, closedAt }
      match /polls/{pollId} {
        function pollFields() {
          return ['status', 'options', 'createdBy', 'winner', 'closedAt'];
        }
        function validOptions(options) {
          return options is list && options.size() >= 1 && options.size() <= 4;
        }
        // Ajout d'UNE option à la fin : ni retrait, ni doublon, 4 maximum.
        function addsOneOption() {
          let before = resource.data.options;
          let after = request.resource.data.options;
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['options'])
            && validOptions(after)
            && after.size() == before.size() + 1
            && after.hasAll(before)
            && !(after[before.size()] in before);
        }
        // Clôture : un gagnant parmi les options, horodatée par le serveur.
        function closes() {
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'winner', 'closedAt'])
            && request.resource.data.status == 'closed'
            && request.resource.data.winner in resource.data.options
            && request.resource.data.closedAt == request.time;
        }

        allow read: if isMember(hid);
        allow create: if isMember(hid)
          && pollId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.keys().hasOnly(pollFields())
          && request.resource.data.keys().hasAll(pollFields())
          && request.resource.data.status == 'open'
          && validOptions(request.resource.data.options)
          && request.resource.data.createdBy is string
          && isMe(hid, request.resource.data.createdBy)
          && request.resource.data.winner == null
          && request.resource.data.closedAt == null;
        // Seul un poll ouvert se modifie : un poll clos ne peut être ni rouvert ni changé.
        allow update: if isMember(hid) && resource.data.status == 'open' && (addsOneOption() || closes());
        allow delete: if false;

        // L'id du doc de vote EST le memberId : un vote par personne, garanti par la structure.
        // { recipeId, updatedAt }. On vote pour soi, tant que c'est ouvert, pour une des options.
        match /votes/{memberId} {
          function poll() {
            return get(/databases/$(database)/documents/households/$(hid)/polls/$(pollId)).data;
          }
          allow read: if isMember(hid);
          allow create, update: if isMember(hid)
            && isMe(hid, memberId)
            && poll().status == 'open'
            && request.resource.data.keys().hasOnly(['recipeId', 'updatedAt'])
            && request.resource.data.recipeId in poll().options
            && request.resource.data.updatedAt == request.time;
          allow delete: if false;
        }
      }
    }
  }
}
